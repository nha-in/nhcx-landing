{
  "name": "nhcx-landing",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 7000",
    "build": "node scripts/sync-stats.mjs --quiet; next build",
    "build:landing": "NEXT_PUBLIC_BASE_PATH=/landing npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "serve:static": "npx -y serve out",
    "sync:stats": "node scripts/sync-stats.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.23",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "js-yaml": "^4.3.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  }
}
